# Sentry Configuration
# Copy this file to .env.local and fill in your values

# Step 1: Get your auth token from: https://sentry.io/settings/account/api/auth-tokens/
# This token is used to upload source maps during build
SENTRY_AUTH_TOKEN="your-sentry-auth-token-here"

# Step 2: Update these with your Sentry organization and project names
# Find these in your Sentry dashboard URL: https://sentry.io/organizations/[org]/projects/[project]/
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"

# Step 3 (Optional): Add your Sentry DSN for error reporting
# Get this from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/your-project-id"

# Optional: Environment
# NODE_ENV="production"
